rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      // In a real app we'd verify this against an admins collection
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    function isHubAgent() {
      // We would verify against the user document to see if they are an employee.
      // We use get() here to fetch role since custom claims are not used.
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['HUB_AGENT', 'HUB_MANAGER', 'MASTER_ADMIN'];
    }

    function existing() {
      return resource.data;
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- USER VALIDATION ---
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'fullName', 'email', 'role', 'kycStatus', 'isActive', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.fullName is string && data.fullName.size() <= 100
        && data.email is string && data.email.size() <= 100
        && data.role is string && data.role in ['SENDER', 'TRAVELER', 'HUB_AGENT', 'HUB_MANAGER', 'HUB_INSPECTOR', 'MASTER_ADMIN', 'EMPLOYEE']
        && data.kycStatus is string && data.kycStatus in ['UNVERIFIED', 'PENDING', 'VERIFIED', 'REJECTED']
        && data.isActive is bool
        && data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isHubAgent() || isAdmin());
      allow create: if isSignedIn() 
                    && request.auth.uid == userId 
                    && isValidId(userId)
                    && isValidUser(incoming())
                    && incoming().id == userId
                    && incoming().role in ['SENDER', 'TRAVELER'] // cannot self-assign admin/hub
                    && incoming().kycStatus == 'UNVERIFIED'
                    && incoming().isActive == true
                    && incoming().createdAt == request.time;
      allow update: if isSignedIn() && isValidId(userId) && isValidUser(incoming()) && (
        (request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'phone', 'preferredLocale'])) ||
        (isAdmin() || isHubAgent())
      );
    }

    // --- SHIPMENT VALIDATION ---
    function isValidShipment(data) {
      return data.keys().hasAll(['id', 'trackingNumber', 'senderId', 'currentStatus', 'createdAt', 'updatedAt'])
        && data.id is string && data.id.size() <= 128
        && data.trackingNumber is string && data.trackingNumber.size() <= 100
        && data.senderId is string && data.senderId.size() <= 128
        && data.currentStatus is string && data.currentStatus.size() <= 50
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /shipments/{shipmentId} {
      allow read: if isSignedIn() && (
        existing().senderId == request.auth.uid || 
        existing().assignedTravelerId == request.auth.uid || 
        isHubAgent() || 
        isAdmin()
      );
      
      allow create: if isSignedIn() 
                    && isValidId(shipmentId)
                    && isValidShipment(incoming())
                    && incoming().id == shipmentId
                    && incoming().senderId == request.auth.uid
                    && incoming().createdAt == request.time
                    && incoming().updatedAt == request.time;
                    
      allow update: if isSignedIn() && isValidId(shipmentId) && isValidShipment(incoming()) && (
        (isHubAgent() || isAdmin()) ||
        // Sender can cancel if draft
        (request.auth.uid == existing().senderId && existing().currentStatus == 'DRAFT' && incoming().diff(existing()).affectedKeys().hasOnly(['currentStatus', 'updatedAt']) && incoming().currentStatus == 'CANCELLED')
      );
    }

    // --- WALLET VALIDATION ---
    function isValidWallet(data) {
      return data.keys().hasAll(['id', 'userId', 'balance', 'lockedEscrowDeposit', 'pendingEarnings', 'currency', 'updatedAt'])
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.balance is number
        && data.lockedEscrowDeposit is number
        && data.pendingEarnings is number
        && data.currency is string && data.currency.size() <= 3
        && data.updatedAt is timestamp;
    }

    match /wallets/{walletId} {
      // Users can read their own wallet, agents/admins can read all.
      allow read: if isSignedIn() && (existing().userId == request.auth.uid || isHubAgent() || isAdmin());
      
      // Wallets are created and updated solely via secure backend functions or Hub Agents.
      // Senders/Travelers cannot manipulate their own balances via client directly.
      allow create, update: if isSignedIn() 
                            && isValidId(walletId) 
                            && isValidWallet(incoming())
                            && (isAdmin() || isHubAgent());
    }

    // --- TRANSACTION VALIDATION ---
    function isValidTransaction(data) {
      return data.keys().hasAll(['id', 'walletId', 'userId', 'type', 'amount', 'currency', 'status', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.walletId is string && data.walletId.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.type is string && data.type.size() <= 50
        && data.amount is number
        && data.currency is string && data.currency.size() <= 3
        && data.status is string && data.status in ['PENDING', 'COMMITTED', 'REVERTED', 'FAILED']
        && data.createdAt is timestamp;
    }

    match /transactions/{transactionId} {
      allow read: if isSignedIn() && (existing().userId == request.auth.uid || isHubAgent() || isAdmin());
      // Transactions are strictly append-only by agents or backend functions
      allow create: if isSignedIn() 
                    && isValidId(transactionId)
                    && isValidTransaction(incoming())
                    && (isAdmin() || isHubAgent())
                    && incoming().createdAt == request.time;
      allow update: if isSignedIn() 
                    && isValidId(transactionId)
                    && isValidTransaction(incoming())
                    && (isAdmin() || isHubAgent())
                    && incoming().diff(existing()).affectedKeys().hasOnly(['status']);
    }
  }
}
