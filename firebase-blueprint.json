{
  "entities": {
    "User": {
      "title": "User",
      "description": "System user including Sender, Traveler, Hub Agent, Admin.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "fullName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 30 },
        "role": { "type": "string", "enum": ["SENDER", "TRAVELER", "HUB_AGENT", "HUB_MANAGER", "HUB_INSPECTOR", "MASTER_ADMIN", "EMPLOYEE"] },
        "kycStatus": { "type": "string", "enum": ["UNVERIFIED", "PENDING", "VERIFIED", "REJECTED"] },
        "isActive": { "type": "boolean" },
        "preferredLocale": { "type": "string", "enum": ["ar", "en"] },
        "assignedHubId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "fullName", "email", "role", "kycStatus", "isActive", "createdAt"]
    },
    "Shipment": {
      "title": "Shipment",
      "description": "Logistics shipment record.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "trackingNumber": { "type": "string", "maxLength": 100 },
        "senderId": { "type": "string", "maxLength": 128 },
        "originHubId": { "type": "string", "maxLength": 128 },
        "destinationHubId": { "type": "string", "maxLength": 128 },
        "itemCategory": { "type": "string", "maxLength": 50 },
        "currentStatus": { "type": "string", "maxLength": 50 },
        "estimatedWeightKg": { "type": "number" },
        "actualWeightKg": { "type": "number" },
        "currency": { "type": "string", "maxLength": 3 },
        "shippingCost": { "type": "number" },
        "escrowDepositRequired": { "type": "number" },
        "assignedTravelerId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "trackingNumber", "senderId", "currentStatus", "createdAt", "updatedAt"]
    },
    "Wallet": {
      "title": "Wallet",
      "description": "User or Employee wallet ledger summary.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "balance": { "type": "number" },
        "lockedEscrowDeposit": { "type": "number" },
        "pendingEarnings": { "type": "number" },
        "currency": { "type": "string", "maxLength": 3 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "balance", "lockedEscrowDeposit", "pendingEarnings", "currency", "updatedAt"]
    },
    "WalletTransaction": {
      "title": "Wallet Transaction",
      "description": "Immutable ledger record for local treasury system.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "transactionCode": { "type": "string", "maxLength": 100 },
        "walletId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "employeeId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "maxLength": 50 },
        "amount": { "type": "number" },
        "currency": { "type": "string", "maxLength": 3 },
        "status": { "type": "string", "enum": ["PENDING", "COMMITTED", "REVERTED", "FAILED"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "walletId", "userId", "type", "amount", "currency", "status", "createdAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Stores user profiles including senders, travelers, and local hub employees."
    },
    "shipments/{shipmentId}": {
      "schema": { "$ref": "#/entities/Shipment" },
      "description": "Stores the logistical shipment records."
    },
    "wallets/{walletId}": {
      "schema": { "$ref": "#/entities/Wallet" },
      "description": "Stores the aggregated balance for each user or employee."
    },
    "transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/WalletTransaction" },
      "description": "Immutable ledger entries for deposits, withdrawals, escrow holds, and releases."
    }
  }
}
